<?xml version="1.0" encoding="UTF-8"?>
<website-design version="1">
  <typography
    body-font="palatino"
    heading-font="palatino"
    nav-font="source-sans"
    body-size="16"
    heading-size="44"
    section-size="26"
    chinese-size="28"
    line-height="1.6"
  />
  <spacing
    paragraph-gap="12"
    section-gap="32"
    publication-gap="18"
  />
  <layout
    page-width="1040"
    portrait-size="168"
    portrait-position="original"
    news-height="320"
  />
  <light
    accent="#005035"
    gold="#A49665"
    paper="#FFFFFF"
    ink="#252B2A"
    muted="#626D68"
    line="#DCE2DE"
    accent-soft="#EEF4F1"
  />
  <dark
    accent="#8FB9A0"
    gold="#C3B387"
    paper="#1B1B1B"
    ink="#E8E4DC"
    muted="#B2AEA6"
    line="#3B3B3B"
    accent-soft="#262626"
  />
</website-design>
